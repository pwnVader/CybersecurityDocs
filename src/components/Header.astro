---
/**
 * Override del header de Starlight para inyectar el "Ecosystem Strip"
 * (portfolio · lab · docs) en una franja superior, manteniendo intacto
 * el header nativo de Starlight (logo + buscador + social icons).
 *
 * IMPORTANTE: no envolver <Default /> en contenedores con flex/items —
 * el componente trae su propia retícula interna (grid + flex) y cualquier
 * wrapper extra hace que los hijos (search, theme, social) se reorganicen
 * o se apilen en columna en lugar de una sola fila.
 *
 * El stacking vertical de la strip + el header nativo se logra en CSS
 * (.header { display:flex; flex-direction:column }) en custom.css.
 */
import Default from '@astrojs/starlight/components/Header.astro';

const links = [
  { href: 'https://pwnvader.com',         label: 'portfolio', current: false },
  { href: 'https://hacking.pwnvader.com', label: 'lab',       current: false },
  { href: 'https://docs.pwnvader.com',    label: 'docs',      current: true  },
];

// Calcular idioma actual y URLs exactas de alternancia de idioma
const pathname = Astro.url.pathname;
const isEnglish = pathname.startsWith('/en/') || pathname === '/en';

let spanishUrl = pathname;
let englishUrl = pathname;

if (isEnglish) {
  spanishUrl = pathname.replace(/^\/en/, '') || '/';
} else {
  englishUrl = `/en${pathname === '/' ? '/' : pathname}`;
}
---
<div class="ecosystem-strip">
  <div class="ecosystem-strip-inner">
    <div class="ecosystem-strip-links">
      <span class="ecosystem-strip-label">ecosystem</span>
      <span class="ecosystem-strip-sep">·</span>
      {links.map(l => l.current ? (
        <span class="ecosystem-strip-current">{l.label}</span>
      ) : (
        <a href={l.href} target="_blank" rel="noopener" class="ecosystem-strip-link">{l.label}</a>
      ))}
    </div>
    
    <div class="lang-selector-cyber">
      <span class="lang-label">lang</span>
      <span class="lang-sep">·</span>
      <a href={spanishUrl} class={`lang-opt ${!isEnglish ? 'active' : ''}`}>ES</a>
      <span class="lang-opt-sep">/</span>
      <a href={englishUrl} class={`lang-opt ${isEnglish ? 'active' : ''}`}>EN</a>
    </div>
  </div>
</div>

<Default {...Astro.props} />

<style>
  /* ── Ecosystem strip ────────────────────────────────────────────
     Estilos encapsulados — no usamos clases utility de tailwind aquí
     porque Starlight inyecta sus propios estilos sobre `.header` y
     pelean con `flex-1`, `w-full`, etc. Mejor CSS plano y predecible.
  ────────────────────────────────────────────────────────────────── */
  .ecosystem-strip {
    width: 100%;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    flex-shrink: 0;
  }
  .ecosystem-strip-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.375rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }
  .ecosystem-strip-links {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--sl-color-gray-4, #585b70);
  }
  .ecosystem-strip-label {
    color: var(--sl-color-gray-4, #585b70);
  }
  .ecosystem-strip-sep {
    color: var(--sl-color-gray-5, #45475a);
  }
  .ecosystem-strip-current {
    color: var(--sl-color-accent, #cba6f7);
    border-bottom: 1px solid var(--sl-color-accent, #cba6f7);
    padding-bottom: 2px;
    margin-bottom: -2px;
    font-weight: 700;
  }
  .ecosystem-strip-link {
    color: var(--sl-color-gray-4, #585b70);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .ecosystem-strip-link:hover {
    color: var(--sl-color-accent, #cba6f7);
  }

  /* ── Cyber Language Selector ──────────────────────────────────── */
  .lang-selector-cyber {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
  }
  .lang-label {
    color: var(--sl-color-gray-4, #585b70);
  }
  .lang-sep {
    color: var(--sl-color-gray-5, #45475a);
  }
  .lang-opt-sep {
    color: var(--sl-color-gray-5, #45475a);
    font-size: 8px;
  }
  .lang-opt {
    color: var(--sl-color-gray-4, #585b70);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s ease, text-shadow 0.15s ease;
  }
  .lang-opt:hover {
    color: var(--sl-color-accent, #cba6f7);
    text-shadow: 0 0 4px rgba(203, 166, 247, 0.4);
  }
  .lang-opt.active {
    color: var(--sl-color-accent, #cba6f7);
    font-weight: 700;
    border-bottom: 1px solid var(--sl-color-accent, #cba6f7);
    padding-bottom: 2px;
    margin-bottom: -2px;
  }

  @media (max-width: 640px) {
    .ecosystem-strip-label,
    .ecosystem-strip-sep {
      display: none;
    }
  }
</style>
