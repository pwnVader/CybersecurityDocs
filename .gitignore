# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#testing)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-modules
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_css/
.rts2_cache_js/

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables files
.env
.env.development.local
.env.local
.env.production.local
.env.shadow
.env.staging.local
.env.test.local

# Astro build outputs
dist/
.astro/

# IDE files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generados por el script de sincronización automática de writeups (docs.pwnvader.com)
# Se ignora el directorio base pero se permite hackthebox/ manualmente
/src/content/docs/writeups/*
!/src/content/docs/writeups/.gitkeep
!/src/content/docs/writeups/hackthebox/
!/src/content/docs/writeups/index.mdx

# Claude
.claude/

